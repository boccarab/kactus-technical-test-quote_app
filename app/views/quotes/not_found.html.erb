<% content_for :title, "Devis introuvable" %>

<main class="flex min-h-screen items-center justify-center bg-white px-5 py-10 text-primary">
  <div class="w-full max-w-lg text-center">
    <p class="text-7xl font-bold text-[#8478A7] sm:text-8xl">404</p>
    <h1 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">Devis introuvable</h1>
    <p class="mx-auto mt-4 max-w-md text-base text-[#8478A7] sm:text-lg">
      Ce devis n’existe pas ou n’est plus disponible.
    </p>

    <%= link_to quotes_path, class: "mt-8 inline-flex items-center gap-3 rounded-md border border-primary px-7 py-3.5 font-semibold transition hover:bg-primary hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" do %>
      <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5m6-6-6 6 6 6"/>
      </svg>
      Retour à mes devis
    <% end %>
  </div>
</main>
