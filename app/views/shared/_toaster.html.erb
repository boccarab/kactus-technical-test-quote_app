<% flash.each do |type, message| %>
  <% next unless message.present? %>
  <% danger = type.to_s == "alert" %>

  <div
    class="pointer-events-auto flex w-full items-start gap-3 rounded-lg border px-4 py-3 text-sm shadow-lg transition duration-300 <%= danger ? "border-danger bg-white text-danger" : "border-primary bg-primary text-white" %>"
    data-controller="toaster"
    data-toaster-delay-value="5000"
    role="<%= danger ? "alert" : "status" %>"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" class="mt-0.5 size-5 shrink-0 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <% if danger %>
        <circle cx="12" cy="12" r="9"/><path d="M12 7v6m0 4h.01"/>
      <% else %>
        <circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/>
      <% end %>
    </svg>

    <p class="flex-1 font-medium"><%= message %></p>

    <button
      type="button"
      class="-m-1 inline-flex size-7 shrink-0 items-center justify-center rounded-md transition hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
      data-action="toaster#dismiss"
      aria-label="Fermer la notification"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 fill-none stroke-current" stroke-width="2" stroke-linecap="round">
        <path d="m6 6 12 12M18 6 6 18"/>
      </svg>
    </button>
  </div>
<% end %>
